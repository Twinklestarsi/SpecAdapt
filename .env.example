# ============================================================
# 配置模板 —— 复制为 .env 后填入你自己的值
#   cp .env.example .env
# 真实的 .env 已被 .gitignore 排除，请勿提交。
# ============================================================

# --- 大模型接口（OpenAI 兼容协议即可）---
CLOUD_API_BASE_URL=https://your-llm-endpoint.example.com/v1
CLOUD_API_KEY=your-api-key-here
CLOUD_MODEL=your-model-name
CLOUD_MAX_TOKENS=65536
CLOUD_TIMEOUT=600

# 旧模块使用的兼容别名，保持指向上面的 CLOUD_* 即可
OPENAI_API_BASE_URL=${CLOUD_API_BASE_URL}
OPENAI_BASE_URL=${CLOUD_API_BASE_URL}
OPENAI_API_KEY=${CLOUD_API_KEY}
OPENAI_MODEL=${CLOUD_MODEL}

# 可选：推理强度与 thinking 开关
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_REASONING_EFFORT=low

# --- 本地大模型（llm_v2v.py --local 时使用）---
LOCAL_API_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_API_KEY=EMPTY
LOCAL_MODEL=your-local-model
LOCAL_MAX_TOKENS=16384
LOCAL_TIMEOUT=300

# --- Design Compiler 远程服务器 ---
DC_REMOTE_USER=your-username
DC_REMOTE_HOST=your.dc.server.example.com
DC_REMOTE_BASE=/path/on/remote/workdir
DC_ENV_SCRIPT=/path/to/dc/env/script.sh
DC_SHELL_PATH=/path/to/dc_shell
ASAP7_DB_PATH=/path/to/asap7/db

# --- JasperGold 远程服务器 ---
JG_ENABLED=true
JG_REMOTE_USER=your-username
JG_REMOTE_HOST=your.jg.server.example.com
JG_REMOTE_BASE=/path/on/remote/workdir
JG_ENV_SCRIPT=/path/to/jg/env/script.sh
JG_BIN=/path/to/jaspergold
JG_TIMEOUT=1000

# --- Memory Agent 数据库路径（留空则用项目根下的 memory_agent.db）---
MEMORY_AGENT_DB_PATH=

# --- 不要让内网 EDA / API 流量走代理 ---
NO_PROXY=127.0.0.1,localhost,your-internal-subnet
no_proxy=127.0.0.1,localhost,your-internal-subnet
